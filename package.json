{
  "name": "voicelens",
  "version": "1.0.0",
  "description": "Real-time voice AI latency profiler and barge-in test harness for OpenAI Realtime, AWS Nova Sonic, and WebRTC audio streams",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "voicelens": "./bin/voicelens.js"
  },
  "type": "module",
  "scripts": {
    "build:core": "tsup",
    "build:studio": "vite build --config src/studio/vite.config.ts",
    "build": "npm run build:core && npm run build:studio",
    "dev:studio": "vite --config src/studio/vite.config.ts",
    "start": "node bin/voicelens.js",
    "test": "vitest run"
  },
  "keywords": [
    "voice-ai",
    "latency-profiler",
    "barge-in",
    "vad",
    "openai-realtime",
    "webrtc",
    "websocket",
    "audio-dsp",
    "speech-latency"
  ],
  "author": "Alexandr Motologa",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
